      "pago": "Valor efectivamente pagado (número sin puntos ni comas)",
      "valor": "Valor del impuesto liquidado (número sin puntos ni comas)",
      "presentado": "Estado: escriba PRESENTADO si ya fue presentado, dejar vacío si no"
    },
    "estados_semaforo": {
      "VENCIDO": "fecha_venc anterior a hoy y presentado vacío",
      "URGENTE": "fecha_venc en los próximos 14 días y presentado vacío",
      "PROXIMO": "fecha_venc entre 15 y 30 días y presentado vacío",
      "PRESENTADO": "campo presentado = PRESENTADO",
      "FUTURO": "fecha_venc mayor a 30 días"
    }
  },
